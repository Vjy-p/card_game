create or replace function increment_room_revision(
    p_room_id text
)
returns bigint
language plpgsql
as
$$
declare
    v_revision bigint;
begin

    update rooms
    set
        revision = revision + 1,
        updated_at = now()
    where id = p_room_id
    returning revision
    into v_revision;

    return v_revision;

end;
$$;